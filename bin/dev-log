#!/usr/bin/env bash
# dev-log: Generate a development activity log from GitHub and Todoist
# Usage: dev-log [options] [days]  (default: 7 days, always includes AI summary)

set -euo pipefail

show_help() {
    cat << 'EOF'
dev-log: Generate a development activity log from GitHub, Todoist, and optionally Claude Code

Usage: dev-log [options] [days]

Arguments:
  days    Number of days to look back (default: 7)

Options:
  h, -h, --help, help    Show this help message
  -s, --sessions      Include Claude Code sessions (off by default)

Environment Variables:
  GITHUB_USER         GitHub username (auto-detected from gh auth)
  TODOIST_API_TOKEN   Todoist API token (or store in ~/.config/todoist/token)
  CODEX_BIN           Codex executable (prefers the ChatGPT bundled binary)

Examples:
  dev-log              Show last 7 days of activity with AI summary
  dev-log 14           Show last 14 days of activity with AI summary
  dev-log --sessions   Include Claude Code sessions
  dev-log -s 30        Show last 30 days with Claude Code sessions
EOF
}

# Parse arguments
DAYS=7
SHOW_SESSIONS=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        h|-h|--help|help)
            show_help
            exit 0
            ;;
        -s|--sessions)
            SHOW_SESSIONS=true
            shift
            ;;
        *)
            # Validate it's a positive integer for days
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                DAYS="$1"
            else
                echo "Error: '$1' is not a valid number of days"
                echo ""
                show_help
                exit 1
            fi
            shift
            ;;
    esac
done
GITHUB_USER="${GITHUB_USER:-$(gh api user --jq '.login' 2>/dev/null || echo '')}"
TODOIST_TOKEN_FILE="$HOME/.config/todoist/token"
TODOIST_API_TOKEN="${TODOIST_API_TOKEN:-$(cat "$TODOIST_TOKEN_FILE" 2>/dev/null || echo '')}"
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"
WORK_LOGS_DIR="$HOME/claude-work-logs"
CODEX_BIN="${CODEX_BIN:-}"

if [[ -z "$CODEX_BIN" ]]; then
    CHATGPT_CODEX_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"
    if [[ -x "$CHATGPT_CODEX_BIN" ]]; then
        CODEX_BIN="$CHATGPT_CODEX_BIN"
    else
        CODEX_BIN="$(command -v codex)"
    fi
fi

# Colors for output
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
MAGENTA='\033[35m'
BLUE='\033[34m'
RESET='\033[0m'

# Calculate cutoff date (macOS/BSD compatible)
if [[ "$OSTYPE" == "darwin"* ]]; then
    CUTOFF_DATE=$(date -v-${DAYS}d +%Y-%m-%d)
    CUTOFF_TS=$(date -v-${DAYS}d +%s)
else
    CUTOFF_DATE=$(date -d "-${DAYS} days" +%Y-%m-%d)
    CUTOFF_TS=$(date -d "-${DAYS} days" +%s)
fi

echo -e "${BOLD}Development Activity Log${RESET} (last $DAYS days, since $CUTOFF_DATE)"
echo ""

# ============================================================================
# TODOIST COMPLETED TASKS
# ============================================================================

if [[ -z "$TODOIST_API_TOKEN" ]]; then
    echo -e "${YELLOW}Todoist token not set. Set TODOIST_API_TOKEN to include completed tasks${RESET}"
else
    # Get all projects to find "professional" and its subprojects
    all_projects=$(curl -s "https://api.todoist.com/api/v1/projects" \
        -H "Authorization: Bearer $TODOIST_API_TOKEN" 2>/dev/null)

    # Check if API response is valid JSON with results
    if ! echo "$all_projects" | jq -e '.results' &>/dev/null; then
        echo -e "${YELLOW}Todoist API error fetching projects. Response: $(echo "$all_projects" | head -1)${RESET}"
    else

    # v1 API wraps projects in {"results": [...]}
    all_projects_array=$(echo "$all_projects" | jq '.results')

    # Get the professional project ID
    professional_project_id=$(echo "$all_projects_array" | \
        jq -r '.[] | select(.name | ascii_downcase == "professional") | .id' 2>/dev/null)

    if [[ -n "$professional_project_id" ]]; then
        # Build a map of project_id -> project_name for easy lookup
        project_map=$(echo "$all_projects_array" | jq -c 'map({key: (.id|tostring), value: .name}) | from_entries' 2>/dev/null)

        # Build list of project IDs: professional + all descendants (up to 3 levels deep)
        # Start with the parent
        project_ids="$professional_project_id"

        # Level 1: direct children
        level1=$(echo "$all_projects_array" | jq -r --arg p "$professional_project_id" '.[] | select(.parent_id == $p) | .id' 2>/dev/null)
        if [[ -n "$level1" ]]; then
            project_ids="$project_ids"$'\n'"$level1"

            # Level 2: grandchildren
            while IFS= read -r pid; do
                [[ -z "$pid" ]] && continue
                level2=$(echo "$all_projects_array" | jq -r --arg p "$pid" '.[] | select(.parent_id == $p) | .id' 2>/dev/null)
                if [[ -n "$level2" ]]; then
                    project_ids="$project_ids"$'\n'"$level2"

                    # Level 3: great-grandchildren
                    while IFS= read -r pid2; do
                        [[ -z "$pid2" ]] && continue
                        level3=$(echo "$all_projects_array" | jq -r --arg p "$pid2" '.[] | select(.parent_id == $p) | .id' 2>/dev/null)
                        [[ -n "$level3" ]] && project_ids="$project_ids"$'\n'"$level3"
                    done <<< "$level2"
                fi
            done <<< "$level1"
        fi

        # Format cutoff date for Todoist API (ISO 8601)
        todoist_since="${CUTOFF_DATE}T00:00:00"

        # Build JSON array of project IDs for jq filtering
        project_ids_json=$(echo "$project_ids" | jq -R -s 'split("\n") | map(select(. != ""))')

        # Get all completed tasks, then filter by our project IDs
        completed_raw=$(curl -s "https://api.todoist.com/api/v1/tasks/completed?since=$todoist_since&limit=200" \
            -H "Authorization: Bearer $TODOIST_API_TOKEN" 2>/dev/null)

        if ! echo "$completed_raw" | jq -e '.items' &>/dev/null; then
            echo -e "${YELLOW}Todoist API error fetching completed tasks. Response: $(echo "$completed_raw" | head -1)${RESET}"
        else
            completed_tasks=$(echo "$completed_raw" | \
                jq -r --argjson ids "$project_ids_json" --argjson pmap "$project_map" \
                '.items[]?
                 | select(.project_id as $pid | $ids | map(. == ($pid | tostring)) | any)
                 | "  \(.completed_at | split("T")[0]) [\(.project_id|tostring | ($pmap[.] // "Unknown"))] \(.content)"' 2>/dev/null | \
                sort -r)

            if [[ -n "$completed_tasks" ]]; then
                echo -e "${BLUE}${BOLD}Todoist Completed (Professional)${RESET}"
                echo -e "${DIM}─────────────────────────────────${RESET}"
                echo "$completed_tasks"
                echo ""
            fi
        fi
    else
        echo -e "${YELLOW}Todoist 'professional' project not found${RESET}"
    fi

    fi  # end valid API response check
fi

# ============================================================================
# GITHUB ACTIVITY
# ============================================================================

if [[ -z "$GITHUB_USER" ]]; then
    echo -e "${YELLOW}GitHub user not detected. Set GITHUB_USER or authenticate with 'gh auth login'${RESET}"
else
    # Issues created
    issues_created=$(gh search issues --author="$GITHUB_USER" --created=">$CUTOFF_DATE" --json title,repository,createdAt,state --limit 50 2>/dev/null | \
        jq -r '.[] | "  \(.createdAt | split("T")[0]) \(.repository.nameWithOwner): \(.title) [\(.state | ascii_downcase)]"' 2>/dev/null | \
        sort -r)
    if [[ -n "$issues_created" ]]; then
        echo -e "${GREEN}${BOLD}GitHub Issues Created${RESET}"
        echo -e "${DIM}─────────────────────${RESET}"
        echo "$issues_created"
        echo ""
    fi

    # Issues closed
    issues_closed=$(gh search issues --author="$GITHUB_USER" --state=closed --closed=">$CUTOFF_DATE" --json title,repository,closedAt --limit 50 2>/dev/null | \
        jq -r '.[] | "  \(.closedAt | split("T")[0]) \(.repository.nameWithOwner): \(.title)"' 2>/dev/null | \
        sort -r)
    if [[ -n "$issues_closed" ]]; then
        echo -e "${GREEN}${BOLD}GitHub Issues Closed${RESET}"
        echo -e "${DIM}────────────────────${RESET}"
        echo "$issues_closed"
        echo ""
    fi

    # PRs still open (created in period, not yet merged)
    prs_open=$(gh search prs --author="$GITHUB_USER" --created=">$CUTOFF_DATE" --state=open --json title,repository,createdAt --limit 50 2>/dev/null | \
        jq -r '.[] | "  \(.createdAt | split("T")[0]) \(.repository.nameWithOwner): \(.title)"' 2>/dev/null | \
        sort -r)
    if [[ -n "$prs_open" ]]; then
        echo -e "${YELLOW}${BOLD}GitHub PRs Still Open${RESET}"
        echo -e "${DIM}─────────────────────${RESET}"
        echo "$prs_open"
        echo ""
    fi

    # PRs merged (with [new] tag if created in the period)
    prs_merged=$(gh search prs --author="$GITHUB_USER" --merged --merged-at=">$CUTOFF_DATE" --json title,repository,closedAt,createdAt --limit 50 2>/dev/null | \
        jq -r --arg cutoff "$CUTOFF_DATE" '.[] |
            (if (.createdAt | split("T")[0]) > $cutoff then " [new]" else "" end) as $tag |
            "  \(.closedAt | split("T")[0]) \(.repository.nameWithOwner): \(.title)\($tag)"' 2>/dev/null | \
        sort -r)
    if [[ -n "$prs_merged" ]]; then
        echo -e "${MAGENTA}${BOLD}GitHub PRs Merged${RESET}"
        echo -e "${DIM}─────────────────${RESET}"
        echo "$prs_merged"
        echo ""
    fi
fi

# ============================================================================
# CLAUDE CODE SESSIONS (optional)
# ============================================================================

if [[ "$SHOW_SESSIONS" == true ]]; then

echo -e "${CYAN}${BOLD}Claude Code Sessions${RESET}"
echo -e "${DIM}────────────────────${RESET}"

# Find all session files modified in the last N days
find_sessions() {
    find "$CLAUDE_PROJECTS_DIR" -name "*.jsonl" -type f -mtime -"$DAYS" 2>/dev/null | \
        grep -v 'agent-' | \
        sort
}

# Extract project name from path
extract_project() {
    local path="$1"
    local dir=$(dirname "$path" | xargs basename)

    # Handle conductor workspaces
    if [[ "$dir" == *"-conductor-workspaces-"* ]]; then
        echo "$dir" | sed 's/.*-conductor-workspaces-//' | cut -d'-' -f1
        return
    fi

    # Handle github paths
    if [[ "$dir" == *"-github-"* ]]; then
        echo "$dir" | sed 's/.*-github-//' | cut -d'-' -f1
        return
    fi

    # Handle home directory
    if [[ "$dir" == "-Users-"* ]] && [[ "$dir" != *"-github-"* ]]; then
        echo "home"
        return
    fi

    # Fallback: last component
    echo "$dir" | rev | cut -d'-' -f1 | rev
}

# Parse a session file and extract summaries with dates
parse_session() {
    local file="$1"
    local project=$(extract_project "$file")

    # Get summaries (these are pre-generated by Claude Code)
    local summaries=$(jq -r 'select(.type=="summary") | .summary' "$file" 2>/dev/null | head -5)

    # Get first timestamp for date
    local first_ts=$(jq -r 'select(.type=="user") | .timestamp' "$file" 2>/dev/null | head -1)

    # Get last timestamp for duration calculation
    local last_ts=$(jq -r 'select(.type=="user" or .type=="assistant") | .timestamp' "$file" 2>/dev/null | tail -1)

    if [[ -z "$first_ts" ]]; then
        return
    fi

    # Filter out sessions older than cutoff date based on actual timestamp
    local session_ts=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${first_ts%.*}" +%s 2>/dev/null || echo "0")
    if [[ "$session_ts" -lt "$CUTOFF_TS" ]]; then
        return
    fi

    # If no summaries, try to extract from first user message (for Conductor sessions)
    if [[ -z "$summaries" ]]; then
        # Get first user message, extract content after all </system_instruction> tags
        local first_msg=$(jq -r 'select(.type=="user") | .message.content' "$file" 2>/dev/null | head -1)

        if [[ "$first_msg" == *"</system_instruction>"* ]]; then
            # Conductor session: extract text after last </system_instruction>
            # Stop at "ultrathink" or "[" (tool results)
            summaries=$(echo "$first_msg" | \
                awk 'BEGIN{RS="</system_instruction>"} END{gsub(/^[[:space:]]+/, ""); print}' | \
                sed 's/ultrathink.*//' | \
                sed 's/\[.*//' | \
                tr '\n' ' ' | \
                sed 's/^[[:space:]]*//' | \
                sed 's/[[:space:]]*$//' | \
                sed 's/  */ /g' | \
                cut -c1-100)
        else
            # Regular session without summaries - use first line of message
            summaries=$(echo "$first_msg" | tr '\n' ' ' | cut -c1-100)
        fi

        # Skip if empty, looks like markup, or is internal system content
        if [[ -z "$summaries" ]] || \
           [[ "$summaries" == "<"* ]] || \
           [[ "$summaries" == "["* ]] || \
           [[ "$summaries" == "Caveat:"* ]] || \
           [[ "$summaries" == "{"* ]]; then
            return
        fi
    fi

    if [[ -z "$summaries" ]]; then
        return
    fi

    # Parse date (just the date part)
    local session_date=$(echo "$first_ts" | cut -d'T' -f1)

    # Calculate duration with 15-minute gap cap
    # Sum up time between messages, but cap any gap > 15 min to 15 min
    local duration=""
    local MAX_GAP=900  # 15 minutes in seconds
    local total_secs=0
    local was_capped=false

    # Get all timestamps and calculate capped duration
    local timestamps=$(jq -r 'select(.type=="user" or .type=="assistant") | .timestamp' "$file" 2>/dev/null | sort)
    local prev_epoch=0

    while IFS= read -r ts; do
        [[ -z "$ts" ]] && continue
        local epoch=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${ts%.*}" +%s 2>/dev/null || echo "0")
        [[ "$epoch" -eq 0 ]] && continue

        if [[ "$prev_epoch" -gt 0 ]]; then
            local gap=$((epoch - prev_epoch))
            if [[ "$gap" -gt "$MAX_GAP" ]]; then
                gap=$MAX_GAP
                was_capped=true
            fi
            total_secs=$((total_secs + gap))
        fi
        prev_epoch=$epoch
    done <<< "$timestamps"

    if [[ "$total_secs" -gt 0 ]]; then
        local mins=$((total_secs / 60))
        local prefix=""
        [[ "$was_capped" == true ]] && prefix="~"
        if [[ $mins -lt 60 ]]; then
            duration="${prefix}${mins}m"
        else
            local hours=$((mins / 60))
            duration="${prefix}${hours}h"
        fi
    fi

    # Output each summary as a separate line
    echo "$summaries" | while read -r summary; do
        if [[ -n "$summary" ]]; then
            echo "$session_date|$project|$duration|$summary"
        fi
    done
}

# Collect and display all sessions
while IFS= read -r file; do
    if [[ -f "$file" ]]; then
        parse_session "$file"
    fi
done < <(find_sessions) | sort -t'|' -k1,1r | while IFS='|' read -r date project duration summary; do
    # Format: date project duration summary
    printf "  ${DIM}%s${RESET} ${BOLD}%s${RESET}" "$date" "$project"
    if [[ -n "$duration" ]]; then
        printf " ${DIM}(%s)${RESET}" "$duration"
    fi
    printf ": %s\n" "$summary"
done

echo ""

fi  # end SHOW_SESSIONS

echo -e "${DIM}Generated at $(date '+%Y-%m-%d %H:%M:%S')${RESET}"

# ============================================================================
# AI SUMMARY
# ============================================================================

# Skip summary if we're in a recursive call (collecting data for summary)
if [[ -z "${_DEV_LOG_COLLECTING:-}" ]]; then
    echo ""
    echo -e "${BOLD}${MAGENTA}AI Summary${RESET}"
    echo -e "${DIM}──────────${RESET}"

    # Re-run with collection flag to get raw output, pipe to Codex
    sessions_flag=""
    [[ "$SHOW_SESSIONS" == true ]] && sessions_flag="--sessions"
    codex_error_log=$(mktemp -t dev-log-codex.XXXXXX)
    trap 'rm -f "$codex_error_log"' EXIT

    if ! _DEV_LOG_COLLECTING=1 "$0" $sessions_flag "$DAYS" 2>/dev/null | "$CODEX_BIN" exec --ephemeral --ignore-user-config --model gpt-5.6-luna -c model_reasoning_effort=low --sandbox read-only --skip-git-repo-check "Summarize this development activity log concisely. Group related work together (e.g., all Flipper Cloud work, all Fireside work, etc.). Focus on what was accomplished, not individual commits. Be brief - aim for 5-10 bullet points max. No preamble, just the summary." 2>"$codex_error_log"; then
        cat "$codex_error_log" >&2
        exit 1
    fi

    rm -f "$codex_error_log"
    trap - EXIT
fi
