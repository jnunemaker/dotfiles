#!/bin/bash
# Create symlinks for files in this directory in ~/

set -e

# change to directory of this script
cd $(dirname $0)/..

# Install Homebrew and packages
if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

brew_skips=()
cask_skips=()

skip_brew_if_command_exists() {
  local formula="$1"
  local command_name="$2"

  if command -v "$command_name" &>/dev/null && ! brew list --formula "$formula" &>/dev/null; then
    echo "Keeping existing $command_name install; skipping Homebrew formula $formula"
    brew_skips+=("$formula")
  fi
}

skip_cask_if_app_exists() {
  local cask="$1"
  local app_name="$2"

  if [ -d "/Applications/$app_name" ] || [ -d "$HOME/Applications/$app_name" ]; then
    cask_skips+=("$cask")
  fi
}

skip_cask_if_command_exists() {
  local cask="$1"
  local command_name="$2"

  if command -v "$command_name" &>/dev/null && ! brew list --cask "$cask" &>/dev/null; then
    echo "Keeping existing $command_name install; skipping Homebrew cask $cask"
    cask_skips+=("$cask")
  fi
}

skip_brew_if_command_exists "bun" "bun"

skip_cask_if_app_exists "arc" "Arc.app"
skip_cask_if_app_exists "chatgpt" "ChatGPT.app"
skip_cask_if_app_exists "claude" "Claude.app"
skip_cask_if_app_exists "codexbar" "CodexBar.app"
skip_cask_if_app_exists "dropbox" "Dropbox.app"
skip_cask_if_app_exists "ghostty" "Ghostty.app"
skip_cask_if_app_exists "google-chrome" "Google Chrome.app"
skip_cask_if_app_exists "obsidian" "Obsidian.app"
skip_cask_if_app_exists "orbstack" "OrbStack.app"
skip_cask_if_app_exists "slack" "Slack.app"
skip_cask_if_app_exists "tailscale-app" "Tailscale.app"
skip_cask_if_app_exists "wispr-flow" "Wispr Flow.app"
skip_cask_if_app_exists "zed" "Zed.app"
skip_cask_if_command_exists "claude-code" "claude"
skip_cask_if_command_exists "codex" "codex"

echo "Installing Homebrew packages..."
HOMEBREW_BUNDLE_BREW_SKIP="${brew_skips[*]}" \
  HOMEBREW_BUNDLE_CASK_SKIP="${cask_skips[*]}" \
  brew bundle --no-upgrade --file="$PWD/Brewfile"

# Install gstack for Claude Code and Codex
gstack_dir="$HOME/.claude/skills/gstack"
if [ ! -e "$gstack_dir" ]; then
  echo "Installing gstack..."
  mkdir -p "$HOME/.claude/skills"
  git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git "$gstack_dir"
  (cd "$gstack_dir" && ./setup)
elif [ ! -d "$gstack_dir/.git" ]; then
  echo "$gstack_dir exists but is not a Git checkout; cannot install gstack" >&2
  exit 1
fi

# Install oh my zsh
if [ ! -d ~/.oh-my-zsh ]; then
  echo "Installing oh-my-zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/robbyrussell/oh-my-zsh/master/tools/install.sh)"
  echo -e "\n\n"
fi

# Install custom zsh plugins
for plugin in zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search; do
  if [ ! -d ~/.oh-my-zsh/custom/plugins/$plugin ]; then
    echo "Installing $plugin..."
    git clone https://github.com/zsh-users/$plugin ~/.oh-my-zsh/custom/plugins/$plugin
  fi
done

backup=~/.dotfiles-backup/$(date -u +"%Y-%m-%dT%H:%M:%SZ")
mkdir -p $backup

echo -e "Installing dotfiles..."
# move any existing dotfiles in homedir to dotfiles_old directory, then create symlinks
for file in *; do
  # Skip scripts and text files
  echo $file | egrep -q '(^script$|^codex$|^ghostty$|\.txt$|\.md|\.json$)' && continue

  if [ -e ~/.$file ]; then
    mv ~/.$file $backup
  fi
  echo "Symlinking $file to ~/.$file"
  ln -sf $PWD/$file ~/.$file
done

symlink_config() {
  local source="$1"
  local target="$2"
  local backup_name="$3"

  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    echo "$target is already symlinked"
    return
  fi

  if [ -e "$target" ] || [ -L "$target" ]; then
    mv "$target" "$backup/$backup_name"
  fi

  echo "Symlinking $source to $target"
  ln -sf "$source" "$target"
}

symlink_config "$PWD/codex/AGENTS.md" "$HOME/.codex/AGENTS.md" "codex-AGENTS.md"
symlink_config "$PWD/ghostty/config" "$HOME/.config/ghostty/config" "ghostty-config"

echo -e "\n\nBacked up old dotfiles to $backup"

# Install marketing skills for Claude Code
if [ ! -d ~/.claude/skills/marketing ]; then
  echo "Installing marketing skills for Claude Code..."
  git clone https://github.com/coreyhaines31/marketingskills.git ~/.claude/skills/marketing
fi

# Install Agent Safehouse
if [ ! -f ~/.local/bin/safehouse ]; then
  echo "Installing Agent Safehouse..."
  mkdir -p ~/.local/bin
  curl -fsSL https://raw.githubusercontent.com/eugene1g/agent-safehouse/main/dist/safehouse.sh \
    -o ~/.local/bin/safehouse
  chmod +x ~/.local/bin/safehouse
fi

# Install summarize via Homebrew
if ! command -v summarize &>/dev/null; then
  echo "Installing summarize..."
  brew install steipete/tap/summarize
fi

# Install Workspace
if ! command -v workspace &>/dev/null; then
  echo "Installing Workspace..."
  curl -fsSL https://raw.githubusercontent.com/jnunemaker/workspace/main/install.sh | bash
fi

if [ ! -d ~/.keyboard ]; then
  git clone https://github.com/jasonrudolph/keyboard.git ~/.keyboard
  cd ~/.keyboard
  script/setup
fi
