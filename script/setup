#!/bin/bash
# Create symlinks for files in this directory in ~/
#
# Setup is silent when everything works. A step that fails prints what it was
# doing and its full output, then stops setup. Only steps that need you, such as
# a password prompt or a browser sign-in, show their output as they run.

set -eE

# Anything that fails outside `quietly` still says where setup stopped.
trap 'echo "✗ setup failed at line $LINENO: $BASH_COMMAND" >&2' ERR

# change to directory of this script
cd "$(dirname "$0")/.."

# Prefer first-party, user-local installers when a tool provides one. Keep
# these paths available during setup before the managed zshrc is loaded.
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

# Run a step with its output hidden, showing that output only if it fails.
# Stdin is closed so a step that unexpectedly prompts fails instead of hanging
# invisibly; sudo still prompts, because it reads the terminal directly.
quietly() {
  local description="$1"
  shift
  local log
  log=$(mktemp)

  if ! "$@" >"$log" 2>&1 </dev/null; then
    trap - ERR
    echo "✗ $description failed:" >&2
    sed 's/^/    /' "$log" >&2
    rm -f "$log"
    exit 1
  fi

  rm -f "$log"
}

# Run a shell pipeline (such as `curl … | sh`) quietly, failing if any part fails.
quietly_sh() {
  local description="$1"
  quietly "$description" /bin/bash -o pipefail -c "$2"
}

install_from_official_script() {
  local command_name="$1"
  local display_name="$2"
  local installer_url="$3"

  if ! command -v "$command_name" &>/dev/null; then
    quietly_sh "Installing $display_name" "curl -fsSL '$installer_url' | /bin/bash"
  fi
}

install_from_official_script "bun" "Bun" "https://bun.com/install"
install_from_official_script "claude" "Claude Code" "https://claude.ai/install.sh"
install_from_official_script "codex" "Codex" "https://chatgpt.com/codex/install.sh"
install_from_official_script "t3" "T3 Code CLI" "https://t3.codes/install.sh"

# Install Homebrew. Its installer asks for your password and confirmation, so it
# runs visibly; it only runs on a Mac without Homebrew.
if ! command -v brew &>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

brew_skips=()
cask_skips=()

skip_brew_if_command_exists() {
  local formula="$1"
  local command_name="$2"

  if command -v "$command_name" &>/dev/null && ! brew list --formula "$formula" &>/dev/null; then
    brew_skips+=("$formula")
  fi
}

skip_cask_if_app_exists() {
  local cask="$1"
  local app_name="$2"

  if [ -d "/Applications/$app_name" ] || [ -d "$HOME/Applications/$app_name" ]; then
    cask_skips+=("$cask")
  fi
}

skip_brew_if_command_exists "node" "node"
skip_brew_if_command_exists "mongodb-community@8.0" "mongod"

# Redis Stack provides the same binaries, even if plain Redis is also installed.
# Keep its links instead of asking Homebrew to link Redis over them.
if brew list --cask redis-stack-server &>/dev/null && command -v redis-server &>/dev/null; then
  brew_skips+=("redis")
fi

skip_cask_if_app_exists "arc" "Arc.app"
skip_cask_if_app_exists "chatgpt" "ChatGPT.app"
skip_cask_if_app_exists "claude" "Claude.app"
skip_cask_if_app_exists "codexbar" "CodexBar.app"
skip_cask_if_app_exists "dropbox" "Dropbox.app"
skip_cask_if_app_exists "ghostty" "Ghostty.app"
skip_cask_if_app_exists "google-chrome" "Google Chrome.app"
skip_cask_if_app_exists "obsidian" "Obsidian.app"
skip_cask_if_app_exists "orbstack" "OrbStack.app"
skip_cask_if_app_exists "slack" "Slack.app"
skip_cask_if_app_exists "t3-code" "T3 Code (Alpha).app"
skip_cask_if_app_exists "tailscale-app" "Tailscale.app"
skip_cask_if_app_exists "todoist-app" "Todoist.app"
skip_cask_if_app_exists "abue-ammar/tinycast/tinycast" "Tinycast.app"
skip_cask_if_app_exists "wispr-flow" "Wispr Flow.app"
skip_cask_if_app_exists "zed" "Zed.app"
dependency_is_skipped() {
  local dependency="$1"
  shift

  local skipped_dependency
  for skipped_dependency in "$@"; do
    if [ "$dependency" = "$skipped_dependency" ]; then
      return 0
    fi
  done

  return 1
}

# Homebrew 6 requires explicit trust for non-official dependencies. Keep trust
# scoped to the exact formula and cask instead of trusting their entire taps.
if ! dependency_is_skipped "mongodb-community@8.0" "${brew_skips[@]}"; then
  quietly "Trusting MongoDB formula" brew trust --formula mongodb/brew/mongodb-community@8.0
  quietly "Trusting MongoDB tools formula" brew trust --formula mongodb/brew/mongodb-database-tools
fi

if ! dependency_is_skipped "codexbar" "${cask_skips[@]}"; then
  quietly "Trusting CodexBar formula" brew trust --formula steipete/tap/codexbar
  quietly "Trusting CodexBar cask" brew trust --cask steipete/tap/codexbar
fi

if ! dependency_is_skipped "abue-ammar/tinycast/tinycast" "${cask_skips[@]}"; then
  quietly "Trusting Tinycast cask" brew trust --cask abue-ammar/tinycast/tinycast
fi

# cctop is no longer managed. Homebrew must briefly trust the exact installed
# cask before it can remove it, after which its trust entry and tap are removed.
if [ -d "$(brew --caskroom)/cctop" ]; then
  quietly "Trusting cctop for removal" brew trust --cask st0012/cctop/cctop
  quietly "Removing cctop" brew uninstall --cask cctop
  quietly "Untrusting cctop" brew untrust --cask st0012/cctop/cctop
fi

if brew tap | grep -q '^st0012/cctop$'; then
  quietly "Removing the cctop tap" brew untap st0012/cctop
fi

quietly "Installing Homebrew packages from the Brewfile" \
  env HOMEBREW_BUNDLE_BREW_SKIP="${brew_skips[*]}" \
  HOMEBREW_BUNDLE_CASK_SKIP="${cask_skips[*]}" \
  brew bundle --no-upgrade --file="$PWD/Brewfile"

# Free ⌘Space for Tinycast by disabling Spotlight's shortcut (symbolic hotkey 64).
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
  "<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1048576</integer></array><key>type</key><string>standard</string></dict></dict>"
quietly "Applying keyboard shortcut changes" \
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

# Tinycast hotkeys are JSON-encoded Carbon key codes and modifiers (⌘ = 256, ⌥ = 2048).
# ⌘Space opens Tinycast; ⌘⌥C opens clipboard history.
defaults write com.tinycast.app hotkey.togglePalette -string \
  '{"combo":{"_0":{"carbonKeyCode":49,"carbonModifiers":256}}}'
defaults write com.tinycast.app hotkey.command:clipboard-history -string \
  '{"combo":{"_0":{"carbonKeyCode":8,"carbonModifiers":2304}}}'
defaults write com.tinycast.app compactMode -bool true
defaults write com.tinycast.app clipboardRetentionDays -int 365
defaults write com.tinycast.app fileSearchEnabled -bool true

# AI uses the installed Claude Code and Codex CLIs, with Apple Intelligence for
# quick actions. Tinycast stores these two settings as JSON data; API keys live
# in the Keychain, not here.
tinycast_write_json() {
  defaults write com.tinycast.app "$1" -data "$(printf '%s' "$2" | xxd -p | tr -d '\n')"
}
defaults write com.tinycast.app aiEnabled -bool true
defaults write com.tinycast.app aiWebSearch -bool true
tinycast_write_json aiInstalledProviders '["claude","codex"]'
tinycast_write_json quickActionModel '{"appleIntelligence":{}}'

# Never record clipboard copies made in 1Password. Until the list is first
# saved, Tinycast falls back to excluding Keychain Access and Passwords, so
# write those too; otherwise add 1Password without disturbing other entries.
if ! defaults read com.tinycast.app clipboardDisabledApps &>/dev/null; then
  defaults write com.tinycast.app clipboardDisabledApps -array \
    com.apple.keychainaccess com.apple.Passwords com.1password.1password
elif ! defaults read com.tinycast.app clipboardDisabledApps | grep -q '"com.1password.1password"'; then
  defaults write com.tinycast.app clipboardDisabledApps -array-add com.1password.1password
fi
# Launcher aliases are keyed by bundle ID; the ChatGPT app is com.openai.codex.
# Tinycast reads them at launch, so restart it after changing them.
defaults write com.tinycast.app launcherAliases -dict-add com.openai.codex codex

# Install Claude Code plugins from the official marketplace. Cloudflare and
# PlanetScale bring their hosted MCP servers, which sign in with OAuth on first
# use, so no API tokens are stored here.
if ! claude plugin marketplace list 2>/dev/null | grep -q 'claude-plugins-official'; then
  quietly "Adding the official Claude Code plugin marketplace" \
    claude plugin marketplace add anthropics/claude-plugins-official
fi

for plugin in cloudflare planetscale; do
  if ! claude plugin list 2>/dev/null | grep -q "$plugin@claude-plugins-official"; then
    quietly "Installing Claude Code plugin $plugin" \
      claude plugin install --scope user "$plugin@claude-plugins-official"
  fi
done

# Codex can't use Claude Code plugins, so add Cloudflare's MCP server directly.
# Adding it opens Cloudflare's OAuth sign-in in the browser, so it runs visibly.
if ! codex mcp get cloudflare &>/dev/null; then
  codex mcp add cloudflare --url https://mcp.cloudflare.com/mcp
fi

# Whether Claude Code has a user-scoped MCP server. Reading ~/.claude.json is
# instant, while `claude mcp get` connects to the server and takes seconds.
claude_has_mcp() {
  plutil -extract "mcpServers.$1" json -o /dev/null "$HOME/.claude.json" 2>/dev/null
}

# Add Honeybadger's hosted MCP server to Claude Code and Codex. It signs in with
# OAuth, so no API token is stored here. Each sign-in grants a single
# Honeybadger account (and all of its projects), so there is one server per
# account; pick the matching account when each sign-in asks. Claude Code signs
# in from /mcp on first use; Codex opens the browser sign-in when the server is
# added, so that runs visibly.
honeybadger_mcp_url="https://mcp.honeybadger.io/mcp"

for account in boxout nunes verygood; do
  server="honeybadger-$account"

  if ! claude_has_mcp "$server"; then
    quietly "Adding Honeybadger MCP server $server to Claude Code" \
      claude mcp add --scope user --transport http "$server" "$honeybadger_mcp_url"
  fi

  if ! codex mcp get "$server" &>/dev/null; then
    echo "Sign in to Honeybadger for Codex's $server server"
    codex mcp add "$server" --url "$honeybadger_mcp_url"
  fi
done

# Add Help Scout's hosted MCP server to Claude Code and Codex. It signs in with
# OAuth as the current Help Scout user and is read-only, so no API token is
# stored here. As with Honeybadger, Codex's sign-in runs visibly.
helpscout_mcp_url="https://mcp.helpscout.net/mcp"

if ! claude_has_mcp helpscout; then
  quietly "Adding Help Scout MCP server to Claude Code" \
    claude mcp add --scope user --transport http helpscout "$helpscout_mcp_url"
fi

if ! codex mcp get helpscout &>/dev/null; then
  echo "Sign in to Help Scout for Codex's helpscout server"
  codex mcp add helpscout --url "$helpscout_mcp_url"
fi

# Add a hosted MCP server that has no OAuth and takes an API token as a bearer
# header on every request. The token lives in this Mac's login Keychain and is
# never stored in this repo. Setup takes it from the Keychain, then from the
# given environment variable, then asks when run in a terminal. Without any of
# those it skips the server rather than waiting for input.
#
#   add_token_mcp <server> <title> <url> <keychain item> <env var> <where to get one>
codex_config="$HOME/.codex/config.toml"

codex_has_mcp() {
  grep -q "^\[mcp_servers\.$1\]" "$codex_config" 2>/dev/null
}

# Set $token for an API token MCP server from the Keychain, the environment
# variable, or a prompt, saving it to the Keychain. Fails with a note when there
# is no token, so the caller can skip that server.
find_token() {
  local title="$1" item="$2" env_var="$3" hint="$4"

  token=$(security find-generic-password -s "$item" -a "$USER" -w 2>/dev/null || true)

  if [ -z "$token" ] && [ -n "${!env_var}" ]; then
    token="${!env_var}"
  fi

  if [ -z "$token" ] && [ -t 0 ]; then
    printf "%s API token (%s, Enter to skip): " "$title" "$hint" >&2
    read -r -s token || true
    echo >&2
  fi

  if [ -z "$token" ]; then
    echo "Skipping $title MCP: no token. Rerun with $env_var=<token> script/setup to add it."
    return 1
  fi

  security add-generic-password -U -s "$item" -a "$USER" -w "$token"
}

# codex mcp add can't set a static header, so write the server table directly.
add_codex_token_mcp() {
  local server="$1" url="$2" token="$3"

  mkdir -p "$(dirname "$codex_config")"
  printf '\n[mcp_servers.%s]\nurl = "%s"\nhttp_headers = { Authorization = "Bearer %s" }\n' \
    "$server" "$url" "$token" >> "$codex_config"
}

add_token_mcp() {
  local server="$1" title="$2" url="$3" item="$4" env_var="$5" hint="$6" token

  if claude_has_mcp "$server" && codex_has_mcp "$server"; then
    return
  fi

  find_token "$title" "$item" "$env_var" "$hint" || return 0

  if ! claude_has_mcp "$server"; then
    quietly "Adding $title MCP server to Claude Code" \
      claude mcp add --scope user --transport http "$server" "$url" \
        --header "Authorization: Bearer $token"
  fi

  if ! codex_has_mcp "$server"; then
    add_codex_token_mcp "$server" "$url" "$token"
  fi
}

add_token_mcp jelly Jelly https://mcp.letsjelly.com/mcp \
  jelly-api-token JELLY_API_TOKEN "Settings → API Tokens in Jelly"

add_token_mcp fireside Fireside https://mcp.fireside.fm/mcp \
  fireside-api-token FIRESIDE_API_TOKEN "the fire_... key from Fireside"

# Add Ahrefs' hosted MCP server to Claude Code and Codex. Claude Code signs in
# with OAuth from /mcp on first use. Codex refuses Ahrefs' OAuth because its
# sign-in page is on a different host than its authorization server, so Codex
# takes an Ahrefs MCP key (not an API v3 key) as a bearer header instead, kept
# in the Keychain like the Jelly and Fireside tokens.
ahrefs_mcp_url="https://api.ahrefs.com/mcp/mcp"

if ! claude_has_mcp ahrefs; then
  quietly "Adding Ahrefs MCP server to Claude Code" \
    claude mcp add --scope user --transport http ahrefs "$ahrefs_mcp_url"
fi

if ! codex_has_mcp ahrefs && find_token Ahrefs ahrefs-mcp-key AHREFS_MCP_KEY \
    "an MCP key from Ahrefs, not an API v3 key"; then
  add_codex_token_mcp ahrefs "$ahrefs_mcp_url" "$token"
fi

unset token

# Install mise with its official installer, which is faster than Homebrew's
# formula and can update itself. Installed tools are kept across the switch.
if brew list --formula mise &>/dev/null; then
  quietly "Removing Homebrew mise" brew uninstall --formula mise
fi

if [ ! -x "$HOME/.local/bin/mise" ]; then
  quietly_sh "Installing mise" "curl -fsSL https://mise.run | sh"
fi

# Install Railway with its recommended installer, which also installs its agent
# skills and the local Railway MCP server (`railway mcp`) for Claude Code.
if brew list --formula railway &>/dev/null; then
  quietly "Removing Homebrew railway" brew uninstall --formula railway
fi

if [ ! -x "$HOME/.railway/bin/railway" ]; then
  quietly_sh "Installing Railway" \
    "curl -fsSL https://railway.com/install.sh | sh -s -- --agents -y --local"
fi

# Install gstack for Claude Code and Codex
gstack_dir="$HOME/.claude/skills/gstack"
if [ ! -e "$gstack_dir" ]; then
  mkdir -p "$HOME/.claude/skills"
  quietly "Cloning gstack" \
    git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git "$gstack_dir"
  quietly_sh "Setting up gstack" "cd '$gstack_dir' && ./setup"
elif [ ! -d "$gstack_dir/.git" ]; then
  trap - ERR
  echo "✗ $gstack_dir exists but is not a Git checkout; cannot install gstack" >&2
  exit 1
fi

# Install oh my zsh. Unattended, so it neither changes the login shell nor
# starts a new zsh; the dotfiles provide ~/.zshrc below.
if [ ! -d ~/.oh-my-zsh ]; then
  quietly_sh "Installing oh-my-zsh" \
    'curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | sh -s -- --unattended --keep-zshrc'
fi

# Install custom zsh plugins
for plugin in zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search; do
  if [ ! -d ~/.oh-my-zsh/custom/plugins/$plugin ]; then
    quietly "Installing zsh plugin $plugin" \
      git clone https://github.com/zsh-users/$plugin ~/.oh-my-zsh/custom/plugins/$plugin
  fi
done

# Replaced files are moved here. The folder is only created when something is
# actually replaced, and setup says so at the end.
backup=~/.dotfiles-backup/$(date -u +"%Y-%m-%dT%H:%M:%SZ")

move_to_backup() {
  mkdir -p "$backup"
  mv "$1" "$backup/$2"
}

symlink_config() {
  local source="$1"
  local target="$2"
  local backup_name="$3"

  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    return
  fi

  mkdir -p "$(dirname "$target")"

  if [ -e "$target" ] || [ -L "$target" ]; then
    move_to_backup "$target" "$backup_name"
  fi

  ln -s "$source" "$target"
}

# Symlink each managed dotfile into ~/, moving anything already there aside.
for file in *; do
  # Skip scripts and text files
  echo $file | egrep -q '(^script$|^codex$|^ghostty$|^preferred-mic$|^mise$|\.txt$|\.md|\.json$)' && continue

  symlink_config "$PWD/$file" "$HOME/.$file" "$file"
done

symlink_config "$PWD/codex/AGENTS.md" "$HOME/.codex/AGENTS.md" "codex-AGENTS.md"
symlink_config "$PWD/ghostty/config" "$HOME/.config/ghostty/config" "ghostty-config"
symlink_config "$PWD/mise/config.toml" "$HOME/.config/mise/config.toml" "mise-config.toml"

# Global tool versions live in the mise config above. A leftover asdf-style
# ~/.tool-versions would override them, so move it to the backup.
if [ -f "$HOME/.tool-versions" ] && [ ! -L "$HOME/.tool-versions" ]; then
  move_to_backup "$HOME/.tool-versions" "tool-versions"
fi

codex_config_source="$PWD/codex/config.toml"
codex_config_target="$HOME/.codex/config.toml"
codex_fallback_setting=$(cat "$codex_config_source")
touch "$codex_config_target"

if ! grep -q '^project_doc_fallback_filenames[[:space:]]*=' "$codex_config_target"; then
  mkdir -p "$backup"
  cp "$codex_config_target" "$backup/codex-config.toml"
  codex_config_temp=$(mktemp)
  awk -v setting="$codex_fallback_setting" '
    !inserted && /^\[/ {
      print setting
      print ""
      inserted = 1
    }
    { print }
    END {
      if (!inserted) {
        print setting
      }
    }
  ' "$codex_config_target" > "$codex_config_temp"
  mv "$codex_config_temp" "$codex_config_target"
fi

quietly "Installing global tools with mise" "$HOME/.local/bin/mise" install

# Keep the Shure MV7 as the default input whenever it is connected, even when
# Bluetooth headphones like AirPods connect and macOS switches to their mic.
preferred_mic_bin="$HOME/.local/bin/preferred-mic"
preferred_mic_source="$PWD/preferred-mic/main.swift"
preferred_mic_label="com.jnunemaker.preferred-mic"
preferred_mic_plist="$HOME/Library/LaunchAgents/$preferred_mic_label.plist"
preferred_mic_plist_temp=$(mktemp)
sed "s|__HOME__|$HOME|g" "$PWD/preferred-mic/$preferred_mic_label.plist" > "$preferred_mic_plist_temp"

if [ ! -x "$preferred_mic_bin" ] || [ "$preferred_mic_source" -nt "$preferred_mic_bin" ] ||
  ! cmp -s "$preferred_mic_plist_temp" "$preferred_mic_plist"; then
  mkdir -p "$(dirname "$preferred_mic_bin")" "$HOME/Library/LaunchAgents"
  quietly "Compiling preferred-mic" swiftc -O "$preferred_mic_source" -o "$preferred_mic_bin"
  mv "$preferred_mic_plist_temp" "$preferred_mic_plist"
  launchctl bootout "gui/$(id -u)/$preferred_mic_label" 2>/dev/null || true
  quietly "Loading the preferred-mic LaunchAgent" \
    launchctl bootstrap "gui/$(id -u)" "$preferred_mic_plist"
else
  rm -f "$preferred_mic_plist_temp"
fi

# Install marketing skills for Claude Code
if [ ! -d ~/.claude/skills/marketing ]; then
  quietly "Installing marketing skills for Claude Code" \
    git clone https://github.com/coreyhaines31/marketingskills.git ~/.claude/skills/marketing
fi

# Install Agent Safehouse
if [ ! -f ~/.local/bin/safehouse ]; then
  mkdir -p ~/.local/bin
  quietly "Installing Agent Safehouse" \
    curl -fsSL https://raw.githubusercontent.com/eugene1g/agent-safehouse/main/dist/safehouse.sh \
    -o ~/.local/bin/safehouse
  chmod +x ~/.local/bin/safehouse
fi

# Install summarize via Homebrew
if ! command -v summarize &>/dev/null; then
  quietly "Installing summarize" brew install steipete/tap/summarize
fi

# Install Workspace
if ! command -v workspace &>/dev/null; then
  quietly_sh "Installing Workspace" \
    "curl -fsSL https://raw.githubusercontent.com/jnunemaker/workspace/main/install.sh | bash"
fi

if [ ! -d ~/.keyboard ]; then
  quietly "Cloning keyboard" git clone https://github.com/jasonrudolph/keyboard.git ~/.keyboard
  quietly_sh "Setting up keyboard" "cd ~/.keyboard && script/setup"
fi

# Files that were replaced are worth knowing about every time it happens.
if [ -d "$backup" ]; then
  echo "Moved replaced files to $backup"
fi
