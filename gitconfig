[user]
	name = John Nunemaker
	email = nunemaker@gmail.com
	signingkey = 2DB63FE78C8E37AC
[github]
	user = jnunemaker
[push]
	default = simple
	autoSetupRemote = true
[credential]
	helper = osxkeychain
[alias]
	co = checkout
  ci = commit
  st = status
  br = branch
  cp = cherry-pick
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
        open = !open `git config remote.origin.url`
  # Amend the last commit
  amend = commit --amend -C HEAD

  # Undo the last commit, preserving the changes
  undo = reset --soft HEAD

  # Show number of commits by each contributor
  count = shortlog -sn

  # List Recent Branches
  recent = for-each-ref --count=5 --sort=-committerdate --format='%(refname:short)' refs/heads/

[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
  pager = true
[core]
	pager = delta
[fetch]
  # Always prune remote branches when fetching
  prune = true
[help]
  autocorrect = 1
[branch]
  autosetuprebase = always
  autosetupmerge = true
[pull]
	rebase = false
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	defaultBranch = main
[delta]
	side-by-side = true
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
